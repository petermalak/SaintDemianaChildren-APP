                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phone\": \"+9876543210\",\n  \"additionalData\": {\n    \"address\": \"Updated Address\"\n  }\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/users/me",
